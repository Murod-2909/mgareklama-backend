# Local development: copy this file to .env (git-ignored):  cp .env.example .env
DJANGO_SECRET_KEY=dev-only
DJANGO_DEBUG=1

# --- Production (systemd EnvironmentFile=/etc/mgareklama/backend.env) ---
# DJANGO_SECRET_KEY=<long random string: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())">
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=api.mgareklama.com
# DJANGO_CORS_EXTRA_ORIGINS=            # optional, comma separated extra frontend origins
# NUM_PROXIES=1                         # reverse proxies in front of gunicorn (nginx)
# ADMIN_BASE_URL=https://api.mgareklama.com

