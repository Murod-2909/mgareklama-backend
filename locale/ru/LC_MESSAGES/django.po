msgid "Upload an image or a video."
msgstr "Загрузите изображение или видео."

msgid "Unsupported video format. Allowed: MP4, MOV, WEBM, M4V."
msgstr "Неподдерживаемый формат видео. Допустимы: MP4, MOV, WEBM, M4V."

msgid "The video is too large (maximum 100 MB)."
msgstr "Видео слишком большое (максимум 100 МБ)."

msgid "The video is too long (maximum 120 seconds)."
msgstr "Видео слишком длинное (максимум 120 секунд)."

msgid "The video could not be processed. Upload a valid video file."
msgstr "Не удалось обработать видео. Загрузите корректный видеофайл."

msgid "Video processing is not available: ffmpeg is not installed on the server."
msgstr "Обработка видео недоступна: на сервере не установлен ffmpeg."

msgid "MP4/MOV/WEBM, up to 120 seconds, up to 100 MB. The poster is created automatically."
msgstr "MP4/MOV/WEBM, до 120 секунд, до 100 МБ. Постер создаётся автоматически."

msgid "Upload an image or a video. For a video the poster is created automatically; upload an image only to use your own poster."
msgstr "Загрузите изображение или видео. Для видео постер создаётся автоматически; загрузите изображение, только чтобы использовать свой постер."

msgid "Video"
msgstr "Видео"

msgid "Preview"
msgstr "Предпросмотр"

msgid "We received your request"
msgstr "Ваш запрос получен"

msgid "Hello, %(name)s!\n\nThank you for contacting MGA Reklama. Your request has been received and we will contact you soon.\n\nMGA Reklama"
msgstr "Здравствуйте, %(name)s!\n\nСпасибо, что обратились в MGA Reklama. Ваш запрос принят, мы свяжемся с вами в ближайшее время.\n\nMGA Reklama"

msgid "Enter a valid phone number."
msgstr "Введите корректный номер телефона."

msgid "Upload an image or a video, or add a video link."
msgstr "Загрузите изображение или видео, либо укажите ссылку на видео."

msgid "Enter a valid Instagram or YouTube link."
msgstr "Введите корректную ссылку на Instagram или YouTube."

msgid "Enter a link to a specific Instagram post or reel (for example https://www.instagram.com/reel/XXXX/)."
msgstr "Укажите ссылку на конкретный пост или reel в Instagram (например, https://www.instagram.com/reel/XXXX/)."

msgid "Enter a link to a specific YouTube video."
msgstr "Укажите ссылку на конкретное видео на YouTube."

msgid "Only Instagram and YouTube links are allowed."
msgstr "Допустимы только ссылки на Instagram и YouTube."

msgid "Video link"
msgstr "Ссылка на видео"

msgid "Instagram or YouTube link (for example https://www.instagram.com/reel/XXXX/). For Instagram also upload a poster image. If a video file is uploaded too, the file takes priority."
msgstr "Ссылка на Instagram или YouTube (например, https://www.instagram.com/reel/XXXX/). Для Instagram также загрузите постер. Если загружен и видеофайл, приоритет у файла."

